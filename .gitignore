# Runtime artifacts generated by the app -- not source, shouldn't be committed
ran_config.db
audit_log.csv

# Anything uploaded through the Streamlit file uploader lands in the repo
# root as a real file -- don't accidentally commit a real site's config
*.xml
!sample_data/*.xml

# Logo -- company/personal branding, decide per-repo whether to commit.
# Gitignored by default; remove this line (or `git add -f`) if you want
# it in the repo so the header renders for anyone who clones it.
vodafone_logo.png

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env / secrets -- never commit API keys
.env
.env.*

# OS / editor cruft
.DS_Store
.vscode/
.idea/
